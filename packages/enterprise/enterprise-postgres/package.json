{
  "name": "@deepseek-ai/dsh-enterprise-postgres",
  "description": "PostgreSQL composition and lifecycle provider for DSH Enterprise",
  "version": "0.1.1-rc.2",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/invariant.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-enterprise-identity-postgres": "workspace:^",
    "@deepseek-ai/dsh-session-persistence-postgres": "workspace:^",
    "@deepseek-ai/dsh-enterprise-catalog": "workspace:^",
    "@deepseek-ai/dsh-enterprise-operations": "workspace:^",
    "@deepseek-ai/dsh-enterprise-device-plane": "workspace:^",
    "@deepseek-ai/dsh-enterprise-cordis": "workspace:^",
    "@deepseek-ai/dsh-knowledge-pgvector": "workspace:^",
    "pg": "^8.16.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-enterprise-cordis": "workspace:^",
    "@types/pg": "^8.15.5"
  }
}
